#!/bin/bash
# omarchy-open-file-url: Open file paths or directories from Kitty hyperlinks or hint keys.
# When running under Herdr, opens as a split pane next to the active pane.
# Outside Herdr, launches an overlay window in Kitty (or new window for directories).
set -euo pipefail

# Ensure clean, responsive pager environment (ANSI colors, terminal selection, status prompt)
export PAGER="${PAGER:-less}"
export LESS="${LESS:--R -i -M -q}"
export LESSHISTFILE=-

file_path="${1:-}"
fragment="${2:-}"

if [[ -z "$file_path" ]]; then
  exit 0
fi

# Strip file:// prefix if present
file_path="${file_path#file://}"
file_path="${file_path#localhost}"

# Extract fragment from file_path if not provided separately
if [[ -z "$fragment" && "$file_path" == *"#"* ]]; then
  fragment="${file_path#*#}"
  file_path="${file_path%%#*}"
fi

# Strip query parameters if present
file_path="${file_path%%\?*}"

# Decode URL percent-encoding (e.g. %20 -> space)
if [[ "$file_path" == *"%"* ]]; then
  file_path=$(python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1]))" "$file_path" 2>/dev/null || printf '%s' "$file_path")
fi

# Expand tilde prefix if present
file_path="${file_path/#\~/$HOME}"

# Helper: check if file is markdown
is_markdown_file() {
  local target="$1"
  case "${target,,}" in
    *.md|*.markdown|*.mdown|*.mkd|*.mkdn|*.mdwn)
      return 0
      ;;
  esac
  return 1
}

# Strategy 1: Herdr workspace split pane
if command -v herdr &>/dev/null && herdr status &>/dev/null; then
  current_info=$(herdr pane current 2>/dev/null || true)
  target_pane="${HERDR_PANE_ID:-$(printf '%s' "$current_info" | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)}"
  pane_cwd=$(printf '%s' "$current_info" | jq -r '.result.pane.cwd // empty' 2>/dev/null || true)

  # Resolve relative path against active pane cwd if needed
  if [[ -n "$pane_cwd" && "$file_path" != /* ]]; then
    file_path="$pane_cwd/$file_path"
  fi

  # Directory handling: split pane with cwd set, list contents, keep shell active
  if [[ -d "$file_path" ]]; then
    split_args=(--direction right --focus --cwd "$file_path")
    if [[ -n "$target_pane" ]]; then
      split_args+=(--pane "$target_pane")
    fi
    split_res=$(herdr pane split "${split_args[@]}" 2>/dev/null || true)
    new_pane=$(printf '%s' "$split_res" | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)
    if [[ -n "$new_pane" ]]; then
      quoted_path=$(printf '%q' "$file_path")
      if command -v yazi &>/dev/null; then
        herdr pane run "$new_pane" "yazi $quoted_path"
      elif command -v eza &>/dev/null; then
        herdr pane run "$new_pane" "eza -la --icons"
      else
        herdr pane run "$new_pane" "ls -la"
      fi
      exit 0
    fi
  fi

  # Markdown file handling: split pane and open in glow -p
  if is_markdown_file "$file_path"; then
    split_args=(--direction right --focus)
    if [[ -n "$target_pane" ]]; then
      split_args+=(--pane "$target_pane")
    fi
    file_dir=$(dirname "$file_path")
    if [[ -d "$file_dir" ]]; then
      split_args+=(--cwd "$file_dir")
    fi
    split_res=$(herdr pane split "${split_args[@]}" 2>/dev/null || true)
    new_pane=$(printf '%s' "$split_res" | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)
    if [[ -n "$new_pane" ]]; then
      quoted_path=$(printf '%q' "$file_path")
      if [[ -e "$file_path" ]]; then
        herdr pane run "$new_pane" "exec glow -p $quoted_path"
      else
        herdr pane run "$new_pane" "glow -p $quoted_path; read -n 1 -s -r -p 'File not found. Press any key to close...'; exit"
      fi
      exit 0
    fi
  fi

  # Other file handling: split pane and open in nvim
  if [[ -f "$file_path" || ! -d "$file_path" ]]; then
    split_args=(--direction right --focus)
    if [[ -n "$target_pane" ]]; then
      split_args+=(--pane "$target_pane")
    fi
    split_res=$(herdr pane split "${split_args[@]}" 2>/dev/null || true)
    new_pane=$(printf '%s' "$split_res" | jq -r '.result.pane.pane_id // empty' 2>/dev/null || true)
    if [[ -n "$new_pane" ]]; then
      quoted_path=$(printf '%q' "$file_path")
      line_num=$(printf '%s' "$fragment" | grep -oP '\d+' | head -n 1 || true)
      if [[ -n "$line_num" ]]; then
        herdr pane run "$new_pane" "nvim +$line_num $quoted_path"
      else
        herdr pane run "$new_pane" "nvim $quoted_path"
      fi
      exit 0
    fi
  fi
fi

# Resolve relative path if still relative outside Herdr
if [[ "$file_path" != /* ]]; then
  file_path="$PWD/$file_path"
fi

# Strategy 2: Kitty remote-control fallback
if [[ -d "$file_path" ]]; then
  if command -v kitten &>/dev/null; then
    kitten @ launch --type=window --cwd "$file_path" 2>/dev/null && exit 0
  fi
  exit 0
fi

# Markdown handling outside Herdr: Kitty overlay with glow -p
if is_markdown_file "$file_path"; then
  if command -v kitten &>/dev/null; then
    kitten @ launch --type=overlay glow -p "$file_path" 2>/dev/null && exit 0
  fi
  exec glow -p "$file_path"
fi

line_num=$(printf '%s' "$fragment" | grep -oP '\d+' | head -n 1 || true)
cmd_args=()
if [[ -n "$line_num" ]]; then
  cmd_args+=("+$line_num")
fi
cmd_args+=("$file_path")

if command -v kitten &>/dev/null; then
  kitten @ launch --type=overlay nvim "${cmd_args[@]}" 2>/dev/null && exit 0
fi

# Strategy 3: Standard editor execution
exec nvim "${cmd_args[@]}"
